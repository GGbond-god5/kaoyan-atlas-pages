# ---------------------------------------------------------------
# 复制本文件为 .env 后填写。.env 不要提交到公开仓库。
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# ---------------------------------------------------------------

# ---------- 基础 ----------
PORT=3000
HOST=127.0.0.1
# production 时开启公开模式：屏蔽 /server、/src、/content 等私有目录
NODE_ENV=development
# 站点对外地址（部署到域名后改成 https://api.your-domain.com）
SITE_URL=http://127.0.0.1:3000
# 只在 HTTPS 下发送 Cookie；线上必须为 1，本地 http 调试填 0
COOKIE_SECURE=0
# 前面有 Nginx / 负载均衡时设为 1，才能拿到真实 IP 做限流
TRUST_PROXY=0
# 网页在 Cloudflare Pages、接口在本机时填 Pages 域名，例如 https://kaoyan-atlas.pages.dev
# 同域部署留空
CORS_ALLOW_ORIGIN=

# ---------- 阿里云凭证 ----------
# 一定要用 RAM 子账号的 AccessKey（主账号 AK 泄露等于账号被接管）
# 权限：AliyunDypnsFullAccess（短信认证）或 AliyunDysmsFullAccess（传统短信）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# ---------- 短信通道 ----------
# pnvs  = 号码认证服务 · 短信认证（个人实名认证就能开通，免资质/免签名/免模板）推荐
# dysms = 传统短信服务（必须企业认证 + 自建签名模板 + 运营商报备）
# mock  = 不真发短信，验证码打印在控制台（本地开发用）
# 不填时：有 AK 就按 pnvs，没有 AK 就 mock
SMS_PROVIDER=

# 地域，固定 cn-hangzhou
ALIYUN_SMS_REGION=cn-hangzhou
# 短信签名名称：pnvs 通道填控制台「短信认证」页面赠送的签名，dysms 通道填自己审核通过的签名
ALIYUN_SMS_SIGN_NAME=
# 模板编号：pnvs 通道留空即用赠送的 100001（登录/注册），dysms 通道填 SMS_xxxxxxxx
ALIYUN_SMS_TEMPLATE_CODE=
# 仅 dysms 通道用：模板里验证码变量的名字，默认 code
ALIYUN_SMS_TEMPLATE_PARAM_KEY=code

# 每日限流（每号码 / 每 IP）
SMS_PHONE_DAILY_LIMIT=10
SMS_IP_DAILY_LIMIT=20

# 会话密钥：填 32 位以上随机字符串；不填会自动生成到 server/data/secret.key
SESSION_SECRET=

# ---------- AI 评卷（沿用 serve.py 的能力，可不填） ----------
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen3-vl-plus
