# Pages 默认给静态资源 max-age=0，每次访问都要回源验证一遍。
# 站点自己的资源都带 ?v= 版本号，所以允许浏览器先用手上的副本，
# 同时在后台悄悄校验，避免长时间拿不到更新。

/assets/*
  Cache-Control: public, max-age=300, stale-while-revalidate=604800

/content/*
  Cache-Control: public, max-age=300, stale-while-revalidate=604800

/pdf/*
  Cache-Control: public, max-age=300, stale-while-revalidate=604800

/*.html
  Cache-Control: no-cache

# 安全响应头（全站）：HSTS、禁止 MIME 嗅探、来源策略、禁止被嵌套。
# CSP：站点大量使用内联脚本，现阶段放行 'unsafe-inline'，主要封堵外源脚本/资源注入；
# 后续若做 nonce 化改造可再收紧 script-src。
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; media-src 'self' blob: data:; frame-ancestors 'none'; base-uri 'self'
